{
  "name": "tickerdb-mcp",
  "version": "3.0.0",
  "mcpName": "com.tickerdb/mcp-server",
  "description": "Point-in-time market data for AI agents: stocks, ETFs and crypto as named bands plus raw values.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tickerdb-mcp": "bin/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/api-key.ts --format esm --dts --external @modelcontextprotocol/sdk --external zod",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "mcp",
    "tickerdb",
    "finance",
    "stock",
    "crypto",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickerdb/tickerdb-mcp.git"
  },
  "homepage": "https://tickerdb.com",
  "author": "TickerDB",
  "bugs": {
    "url": "https://github.com/tickerdb/tickerdb-mcp/issues"
  }
}
